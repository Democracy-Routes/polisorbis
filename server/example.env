# These variables will be overriden by those set in the environment.
# docker compose will use the root level .env file and ignore this one.
# This file is intended to be used for local development.
# It can optionally be included when running the server in a docker
# container, for example `docker run --env-file .env`.

API_DEV_HOSTNAME=localhost:5000
API_SERVER_PORT=5000
DATABASE_URL=postgres://postgres:oiPorg3Nrz0yqDLE@localhost:5432/polis-dev
DEV_MODE=true
DOMAIN_OVERRIDE=
EMAIL_TRANSPORT_TYPES=maildev
MATH_ENV=prod
POLIS_FROM_ADDRESS="Example <team@example.com>"
SERVER_LOG_LEVEL=info
STATIC_FILES_ADMIN_PORT=8080
STATIC_FILES_PARTICIPATION_PORT=8080
STATIC_FILES_HOST=localhost

P_LOGO_ICO_URL=docs/polisorbis-logo-square.png
P_LOGO_URL=docs/polisorbis-logo.png
P_TITLE=PolisOrbis
P_CLAIM="Input Crowdy"
P_DESCRIPTION=PolisOrbis is a real-time system for gathering, analyzing and understanding what large groups of people think in their own words, enabled by advanced statistics and machine learning
P_DOC_URL=
P_REPO_URL=
P_TOS_URL=
P_PRIVACY_POLICY_URL=

###### AI STATEMENT DRAFTING ######
# Off unless AI_PROVIDER_BASE_URL and AI_MODEL are set. Any OpenAI-compatible
# chat API: Mistral https://api.mistral.ai/v1, OpenAI https://api.openai.com/v1,
# Anthropic https://api.anthropic.com/v1, Ollama Cloud https://ollama.com/v1,
# a local Ollama http://host:11434/v1 (no key), vLLM, Groq, OpenRouter...
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Shown to organizers and in the privacy page; derived from the host if blank
# (Mistral, OpenAI, Anthropic, Google, Ollama Cloud, Groq, OpenRouter are known).
AI_PROVIDER_NAME=
AI_PROVIDER_REGION=
AI_PROVIDER_PRIVACY_URL=
# auto (JSON mode for Mistral and OpenAI only), on, off
AI_JSON_MODE=
